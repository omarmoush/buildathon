# Copy to .env for local runs. On Replit, set these as Secrets.
SESSION_SECRET=
MESHY_API_KEY=
# MESHY_DEMO=true   # force the free demo model even when a key is set

# Paymob Egypt — Dashboard > Settings / Developers
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
# Legacy API key (not used by the Intention API flow)
PAYMOB_API_KEY=
# Public base URL Paymob calls back to (webhooks need a public HTTPS URL).
# Defaults to the incoming request's origin.
PUBLIC_BASE_URL=
